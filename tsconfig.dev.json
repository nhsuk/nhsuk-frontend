{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "types": [
      "@nhsuk/frontend-helpers/jest/environment/jsdom",
      "@testing-library/jest-dom",
      "jest",
      "node",
      "typed-query-selector"
    ]
  },
  "include": [
    "./packages/*/src/**/*.test.mjs",
    "./packages/*/tasks/**/*.mjs",
    "./packages/*/gulpfile.mjs",
    "./packages/*/.htmlvalidate.mjs",
    "./packages/*/*.config.js",
    "./packages/*/*.config.mjs",
    "./shared/helpers/**/*.mjs",
    "./tests/backstop/engine_scripts/**/*.js",
    "./tests/types/*.mts",
    "./.prettierrc.js",
    "./.stylelintrc.js",
    "./*.config.js",
    "./*.config.mjs"
  ]
}
