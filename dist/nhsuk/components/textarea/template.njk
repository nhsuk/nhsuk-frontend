{% from "nhsuk/components/error-message/macro.njk" import errorMessage %}
{% from "nhsuk/components/hint/macro.njk" import hint %}
{% from "nhsuk/components/label/macro.njk" import label %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-textarea" -%}
{%- set classNamesFormGroup = "nhsuk-form-group" -%}

{#- Support label as string #}
{%- set labelOptions = params.label if params.label is mapping and params.label is not escaped else {
  text: params.label if params.label is string else undefined,
  html: params.label if params.label is escaped else undefined
} -%}

{#- Support hint as string #}
{%- set hintOptions = params.hint if params.hint is mapping and params.hint is not escaped else {
  text: params.hint if params.hint is string else undefined,
  html: params.hint if params.hint is escaped else undefined
} -%}

{#- Support error message as string #}
{%- set errorMessageOptions = params.errorMessage if params.errorMessage is mapping and params.errorMessage is not escaped else {
  text: params.errorMessage if params.errorMessage is string else undefined,
  html: params.errorMessage if params.errorMessage is escaped else undefined
} -%}

{%- if errorMessageOptions.text or errorMessageOptions.html or params.errorMessage == true %}
  {% set classNames = classNames ~ " nhsuk-textarea--error" %}
  {% set classNamesFormGroup = classNamesFormGroup ~ " nhsuk-form-group--error" %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- if params.formGroup.classes %}
  {% set classNamesFormGroup = classNamesFormGroup ~ " " ~ params.formGroup.classes %}
{% endif %}

{#- a record of other elements that we need to associate with the input using
  aria-describedby – for example hints or error messages -#}
{% set describedBy = params.describedBy if params.describedBy else "" %}
{%- set id = params.id if params.id else params.name -%}

<div class="{{ classNamesFormGroup }}" {{- nhsukAttributes(params.formGroup.attributes) }}>
  {{ label({
    html: labelOptions.html,
    text: labelOptions.text,
    id: labelOptions.id,
    for: labelOptions.for | default(id),
    size: labelOptions.size,
    isPageHeading: labelOptions.isPageHeading,
    classes: labelOptions.classes,
    attributes: labelOptions.attributes
  }) | trim | indent(2) }}
{% if hintOptions.text or hintOptions.html %}
  {% set hintId = hintOptions.id | default(id ~ "-hint") %}
  {% set describedBy = (describedBy ~ " " ~ hintId) | trim %}
  {{ hint({
    html: hintOptions.html,
    text: hintOptions.text,
    id: hintOptions.id | default(hintId),
    classes: hintOptions.classes,
    attributes: hintOptions.attributes
  }) | trim | indent(2) }}
{% endif %}
{% if errorMessageOptions.text or errorMessageOptions.html %}
  {% set errorId = errorMessageOptions.id | default(id ~ "-error") %}
  {% set describedBy = (describedBy ~ " " ~ errorId) | trim %}
  {{ errorMessage({
    html: errorMessageOptions.html,
    text: errorMessageOptions.text,
    visuallyHiddenText: errorMessageOptions.visuallyHiddenText,
    id: errorMessageOptions.id | default(errorId),
    classes: errorMessageOptions.classes,
    attributes: errorMessageOptions.attributes
  }) | trim | indent(2) }}
{% endif %}
{% if params.formGroup.beforeInput %}
  {{ params.formGroup.beforeInput.html | safe | trim | indent(2) if params.formGroup.beforeInput.html else params.formGroup.beforeInput.text }}
{% endif %}
  <textarea class="{{ classNames }}" id="{{ id }}" name="{{ params.name }}" rows="{{ params.rows | default(5, true) }}"
  {%- if params.spellcheck in [true, false] %} spellcheck="{{ params.spellcheck }}"{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if describedBy %} aria-describedby="{{ describedBy }}"{% endif %}
  {%- if params.autocomplete %} autocomplete="{{ params.autocomplete }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>{{ params.value }}</textarea>
{% if params.formGroup.afterInput %}
  {{ params.formGroup.afterInput.html | safe | trim | indent(2) if params.formGroup.afterInput.html else params.formGroup.afterInput.text }}
{% endif %}
</div>
