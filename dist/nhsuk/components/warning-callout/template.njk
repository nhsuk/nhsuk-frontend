{% from "nhsuk/components/card/macro.njk" import card -%}

{%- set options = {
  id: params.id,
  heading: params.heading,
  headingClasses: params.headingClasses,
  headingLevel: params.headingLevel | default(3),
  headingVisuallyHiddenText: params.visuallyHiddenText | default("Important", true)
    if params.heading and not ("Important" in params.heading or "important" in params.heading)
    else undefined,
  description: params.text,
  descriptionHtml: params.html,
  actions: params.actions,
  classes: params.classes,
  attributes: params.attributes,
  variant: "warning"
} -%}

{% if caller %}
  {%- call card(options) %}
    {{- caller() }}
  {%- endcall %}
{% else %}
  {{- card(options) | trim }}
{% endif %}
