{% from "nhsuk/components/error-message/macro.njk" import errorMessage as nhsukErrorMessage %}
{% from "nhsuk/components/hint/macro.njk" import hint as nhsukHint %}
{% from "nhsuk/components/label/macro.njk" import label as nhsukLabel %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-input" -%}
{%- set classNamesInputWrapper = "nhsuk-input-wrapper" -%}
{%- set classNamesFormGroup = "nhsuk-form-group" -%}

{#- Support label as string #}
{%- set label = params.label if params.label is mapping and params.label is not escaped else {
  text: params.label if params.label is string else undefined,
  html: params.label if params.label is escaped else undefined
} -%}

{#- Support hint as string #}
{%- set hint = params.hint if params.hint is mapping and params.hint is not escaped else {
  text: params.hint if params.hint is string else undefined,
  html: params.hint if params.hint is escaped else undefined
} -%}

{#- Support error message as string #}
{%- set errorMessage = params.errorMessage if params.errorMessage is mapping and params.errorMessage is not escaped else {
  text: params.errorMessage if params.errorMessage is string else undefined,
  html: params.errorMessage if params.errorMessage is escaped else undefined
} -%}

{%- if params.large and (not params.classes or not "nhsuk-input--large" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-input--large" %}
  {% set classNamesInputWrapper = classNamesInputWrapper ~ " nhsuk-input-wrapper--large" %}
{% endif %}

{%- if params.code and (not params.classes or not "nhsuk-input--code" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-input--code" %}
{% endif %}

{%- if errorMessage.text or errorMessage.html or params.errorMessage == true %}
  {% set classNames = classNames ~ " nhsuk-input--error" %}
  {% set classNamesFormGroup = classNamesFormGroup ~ " nhsuk-form-group--error" %}
{% endif %}

{%- if params.width and
  params.width | string in ["2", "3", "4", "4", "5", "10", "20", "30"] and (
    not params.classes or (
      not "nhsuk-input--width-2" in params.classes and
      not "nhsuk-input--width-3" in params.classes and
      not "nhsuk-input--width-4" in params.classes and
      not "nhsuk-input--width-5" in params.classes and
      not "nhsuk-input--width-10" in params.classes and
      not "nhsuk-input--width-20" in params.classes and
      not "nhsuk-input--width-30" in params.classes
    )
  )
%}
  {% set classNames = classNames ~ " nhsuk-input--width-" ~ params.width %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- if params.inputWrapper.classes %}
  {% set classNamesInputWrapper = classNamesInputWrapper ~ " " ~ params.inputWrapper.classes %}
{% endif %}

{%- if params.formGroup.classes %}
  {% set classNamesFormGroup = classNamesFormGroup ~ " " ~ params.formGroup.classes %}
{% endif %}

{#- a record of other elements that we need to associate with the input using
  aria-describedby – for example hints or error messages -#}
{% set describedBy = params.describedBy if params.describedBy else "" -%}
{%- set id = params.id if params.id else params.name -%}

{#- Support prefix as string #}
{%- set prefix = params.prefix if params.prefix is mapping and params.prefix is not escaped else {
  text: params.prefix if params.prefix is string else undefined,
  html: params.prefix if params.prefix is escaped else undefined
} -%}

{#- Support suffix as string #}
{%- set suffix = params.suffix if params.suffix is mapping and params.suffix is not escaped else {
  text: params.suffix if params.suffix is string else undefined,
  html: params.suffix if params.suffix is escaped else undefined
} -%}

{%- set hasPrefix = true if prefix.text or prefix.html else false %}
{%- set hasSuffix = true if suffix.text or suffix.html else false %}
{%- set hasBeforeInput = true if params.formGroup.beforeInput and (params.formGroup.beforeInput.text or params.formGroup.beforeInput.html) else false %}
{%- set hasAfterInput = true if params.formGroup.afterInput and (params.formGroup.afterInput.text or params.formGroup.afterInput.html) else false %}

{%- macro _inputElement(params) -%}
  <input
    {{- nhsukAttributes({
      class: classNames,
      id: id,
      name: params.name,
      type: params.type | default("text", true),
      spellcheck: {
        value: params.spellcheck | string
          if params.spellcheck in [true, false]
          else false,
        optional: true
      },
      value: {
        value: params.value,
        optional: true
      },
      disabled: {
        value: params.disabled,
        optional: true
      },
      "aria-describedby": {
        value: describedBy if describedBy else false,
        optional: true
      },
      autocomplete: {
        value: params.autocomplete,
        optional: true
      },
      autocapitalize: {
        value: params.autocapitalize,
        optional: true
      },
      pattern: {
        value: params.pattern,
        optional: true
      },
      placeholder: {
        value: params.placeholder,
        optional: true
      },
      inputmode: {
        value: params.inputmode,
        optional: true
      }
    }) -}}

    {{- nhsukAttributes(params.attributes) }}>
{%- endmacro -%}

{%- macro _affixItem(affix, type) %}
  <div class="nhsuk-input-wrapper__{{ type }} {%- if affix.classes %} {{ affix.classes }}{% endif %}" aria-hidden="true" {{- nhsukAttributes(affix.attributes) }}>
    {{- affix.html | safe | trim | indent(4) if affix.html else affix.text -}}
  </div>
{%- endmacro -%}

<div class="{{ classNamesFormGroup }}" {{- nhsukAttributes(params.formGroup.attributes) }}>
  {{ nhsukLabel({
    html: label.html,
    text: label.text,
    visuallyHiddenText: label.visuallyHiddenText,
    caption: label.caption,
    id: label.id,
    for: label.for | default(id),
    size: label.size,
    heading: label.heading,
    isPageHeading: label.isPageHeading,
    classes: label.classes,
    attributes: label.attributes
  }) | trim | indent(2) }}
{% if hint.text or hint.html %}
  {% set hintId = hint.id | default(id ~ "-hint") %}
  {% set describedBy = (describedBy ~ " " ~ hintId) | trim %}
  {{ nhsukHint({
    html: hint.html,
    text: hint.text,
    id: hint.id | default(hintId),
    classes: hint.classes,
    attributes: hint.attributes
  }) | trim | indent(2) }}
{% endif %}
{% if errorMessage.text or errorMessage.html %}
  {% set errorId = errorMessage.id | default(id ~ "-error") %}
  {% set describedBy = (describedBy ~ " " ~ errorId) | trim %}
  {{ nhsukErrorMessage({
    html: errorMessage.html,
    text: errorMessage.text,
    visuallyHiddenText: errorMessage.visuallyHiddenText,
    id: errorMessage.id | default(errorId),
    classes: errorMessage.classes,
    attributes: errorMessage.attributes
  }) | trim | indent(2) }}
{% endif %}

{%- if hasPrefix or hasSuffix or hasBeforeInput or hasAfterInput or params.inputWrapper.classes or params.inputWrapper.attributes %}
  <div class="{{ classNamesInputWrapper }}" {{- nhsukAttributes(params.inputWrapper.attributes) }}>
    {% if hasBeforeInput %}
      {{- params.formGroup.beforeInput.html | safe | trim | indent(4, true) if params.formGroup.beforeInput.html else params.formGroup.beforeInput.text }}
    {% endif %}
    {% if hasPrefix %}
      {{- _affixItem(params.prefix, "prefix") | indent(2, true) }}
    {% endif %}
    {{ _inputElement(params) }}
    {% if hasSuffix %}
      {{- _affixItem(params.suffix, "suffix") | indent(2, true) }}
    {% endif %}
    {% if hasAfterInput %}
      {{- params.formGroup.afterInput.html | safe | trim | indent(4, true) if params.formGroup.afterInput.html else params.formGroup.afterInput.text }}
    {% endif %}
  </div>
{% else %}
  {{ _inputElement(params) }}
{% endif %}
</div>
