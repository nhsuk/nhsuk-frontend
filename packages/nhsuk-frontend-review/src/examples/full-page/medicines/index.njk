{% extends "layouts/page.njk" %}

{% set mainClasses = "nhsuk-main-wrapper--s" %}
{% set pageHeading = "Medicines A to Z" %}

{% block header %}
  {{ header({
    logo: {
      href: baseUrl
    },
    search: true,
    account: {
      items: [
        {
          action: "#",
          text: "My account"
        }
      ]
    },
    navigation: {
      items: [
        {
          text: "Health A to Z",
          href: baseUrl ~ "examples/full-page/health-a-to-z/",
          active: true
        },
        {
          text: "NHS services",
          href: "#"
        },
        {
          text: "Healthy living",
          href: "#"
        },
        {
          text: "Mental health",
          href: "#"
        },
        {
          text: "Care and support",
          href: "#"
        }
      ]
    }
  }) }}
  {% include "partials/banner-header.njk" %}
{% endblock %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: "Home",
        href: baseUrl
      },
      {
        text: "Health A to Z",
        href: baseUrl ~ "examples/full-page/health-a-to-z/"
      }
    ]
  }) }}
{% endblock %}

