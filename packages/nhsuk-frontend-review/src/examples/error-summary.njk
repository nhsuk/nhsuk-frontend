{% extends "layouts/example.njk" %}

{% set pageName = "Error summary – Link to an input field" %}
{% set mainClasses = "nhsuk-main-wrapper--s" %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: "NHS.UK frontend",
        href: baseUrl
      },
      {
        text: "Examples",
        href: baseUrl ~ "#examples"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">

      <form action="/" method="post" style="margin-bottom: 100vh;">

        {{ errorSummary({
          heading: {
            text: "There is a problem"
          },
          errorList: [
            {
              text: "Problem with input",
              href: "#input"
            },
            {
              text: "Problem with textarea",
              href: "#textarea"
            },
            {
              text: "Problem with select",
              href: "#select"
            },
            {
              text: "Problem with date input",
              href: "#dateinput-day"
            },
            {
              text: "Problem with date input year",
              href: "#dateinput2-year"
            },
            {
              text: "Problem with file",
              href: "#file"
            },
            {
              text: "Problem with radios",
              href: "#radios"
            },
            {
              text: "Problem with checkboxes",
              href: "#checkboxes"
            },
            {
              text: "Problem with single checkbox",
              href: "#single-checkbox"
            },
            {
              text: "Problem with conditionally-revealed input",
              href: "#yes-input"
            },
            {
              text: "Problem with radios with big heading",
              href: "#radios-big-heading"
            },
            {
              text: "Problem with input within large fieldset",
              href: "#address-postcode"
            }
          ]
        }) }}

        {{ heading({
          text: "Your details",
          size: "xl"
        }) }}

        <p class="nhsuk-lede-text">Advice, tips and tools to help you make the best choices about your health and wellbeing.</p>

        {{ heading({
          text: "Heading for input",
          classes: "nhsuk-u-margin-bottom-2",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Integer posuere erat a ante venenatis dapibus posuere.</p>

        {{ input({
          label: {
            text: "Label for input",
            size: "l"
          },
          id: "input",
          name: "input",
          errorMessage: {
            text: "Problem with input"
          }
        }) }}

        {{ heading({
          caption: "Caption for textarea",
          text: "Heading for textarea",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Duis mollis, est non commodo luctus, nisi erat porttitor ligula, eget lacinia odio sem nec elit.</p>

        {{ textarea({
          label: {
            text: "Label for textarea",
            size: "l"
          },
          id: "textarea",
          name: "textarea",
          errorMessage: {
            text: "Problem with textarea"
          }
        }) }}

        {{ heading({
          caption: "Caption for select",
          text: "Heading for select",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Aenean lacinia bibendum nulla sed consectetur. Vestibulum id ligula porta felis euismod semper. Donec id elit non mi porta gravida at eget metus.</p>

        {{ select({
          label: {
            text: "Label for select",
            size: "l"
          },
          id: "select",
          name: "select",
          errorMessage: {
            text: "Problem with select"
          },
          items: [
            {
              text: "Option one",
              value: "one"
            },
            {
              text: "Option two",
              value: "two"
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for date input",
          text: "Heading for date input",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh.</p>

        {{ dateInput({
          fieldset: {
            legend: {
              text: "Label for date input",
              size: "l"
            },
            attributes: {
              id: "test-date-input"
            }
          },
          id: "dateinput",
          namePrefix: "dateinput",
          errorMessage: {
            text: "Problem with date input"
          },
          items: [
            {
              name: "day",
              width: 2,
              error: true
            },
            {
              name: "month",
              width: 2,
              error: true
            },
            {
              name: "year",
              width: 4,
              error: true
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for date input",
          text: "Heading for date input",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Cras justo odio, dapibus ac facilisis in, egestas eget quam. Maecenas sed diam eget risus varius blandit sit amet non magna.</p>

        {{ dateInput({
          fieldset: {
            legend: {
              text: "Label for date input",
              size: "l"
            },
            attributes: {
              id: "test-date-input2"
            }
          },
          id: "dateinput2",
          namePrefix: "dateinput2",
          errorMessage: {
            text: "Problem with date input year"
          },
          items: [
            {
              name: "day",
              value: "5",
              width: 2
            },
            {
              name: "month",
              value: "12",
              width: 2
            },
            {
              name: "year",
              width: 4,
              error: true
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for file upload",
          text: "Heading for file upload",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Bibendum commodo ullamcorper vulputate.</p>

        <ul class="nhsuk-list nhsuk-list--bullet">
          <li>whatever mix of text, paragraphs, lists and examples best explains your question to users</li>
        </ul>

        {{ fileUpload({
          label: {
            text: "Label for file upload",
              size: "l"
          },
          id: "file",
          name: "file",
          errorMessage: {
            text: "Problem with file"
          }
        }) }}

        {{ heading({
          caption: "Caption for radios",
          text: "Heading for radios",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Cras mattis consectetur purus sit amet fermentum. Curabitur blandit tempus porttitor.</p>

        {{ radios({
          fieldset: {
            legend: {
              text: "Legend for radios",
              size: "l"
            },
            attributes: {
              id: "test-radios"
            }
          },
          name: "radios",
          errorMessage: {
            text: "Problem with radios"
          },
          items: [
            {
              text: "Label for first radio button",
              value: "one",
              id: "radios"
            },
            {
              text: "Label for second radio button",
              value: "two"
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for checkboxes",
          text: "Heading for checkboxes",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Integer posuere erat a ante venenatis dapibus posuere.</p>

        <ul class="nhsuk-list nhsuk-list--bullet">
          <li>a label, above the form input, that asks users a specific question – for example, 'Do you have any interview needs?'</li>
        </ul>

        {{ checkboxes({
          fieldset: {
            legend: {
              text: "Legend for checkboxes",
              size: "l"
            },
            attributes: {
              id: "test-checkboxes"
            }
          },
          name: "checkboxes",
          errorMessage: {
            text: "Problem with checkboxes"
          },
          items: [
            {
              text: "Label for first checkbox",
              value: "one",
              id: "checkboxes"
            },
            {
              text: "Label for second checkbox",
              value: "two"
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for single checkbox",
          text: "Heading for single checkbox",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Duis mollis, est non commodo luctus, nisi erat porttitor ligula, eget lacinia odio sem nec elit.</p>

        {{ checkboxes({
          fieldset: false,
          name: "single-checkbox",
          errorMessage: {
            text: "Problem with single checkbox"
          },
          items: [
            {
              text: "Label for single checkbox",
              value: "agree",
              id: "single-checkbox"
            }
          ]
        }) }}

        {% set yesField %}
        {{ input({
          label: {
            text: "Label for revealed text input",
            size: "s"
          },
          id: "yes-input",
          name: "yes-input",
          errorMessage: {
            text: "Problem with input"
          }
        }) }}
        {% endset %}

        {% set noField %}
        {{ input({
          label: {
            text: "Label for revealed text input",
            size: "s"
          },
          id: "no-input",
          name: "no-input",
          errorMessage: {
            text: "Problem with input"
          }
        }) }}
        {% endset %}

        {{ heading({
          caption: "Caption for radios",
          text: "Heading for radios",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Aenean lacinia bibendum nulla sed consectetur. Vestibulum id ligula porta felis euismod semper. Donec id elit non mi porta gravida at eget metus.</p>

        {{ radios({
          idPrefix: "conditional",
          name: "conditional",
          fieldset: {
            legend: {
              text: "Legend for conditionally revealed content",
              size: "l"
            },
            classes: "nhsuk-radios--error",
            attributes: {
              id: "test-conditional-reveal"
            }
          },
          items: [
            {
              value: "yes",
              text: "Yes",
              checked: true,
              conditional: {
                html: yesField
              }
            },
            {
              value: "no",
              text: "No",
              conditional: {
                html: noField
              }
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for radios",
          text: "Heading for radios",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh.</p>

        {{ radios({
          inline: true,
          idPrefix: "radios-big-heading",
          name: "radios-big-heading",
          fieldset: {
            legend: {
              text: "Have you supplied orders signed in triplicate, sent in, sent back, queried, lost, found, subjected to public inquiry, lost again, and finally buried in soft peat for three months and recycled as firelighters?",
              size: "l"
            },
            attributes: {
              id: "test-radios-big-heading"
            }
          },
          errorMessge: {
            text: "Select whether you have supplied orders meeting these criteria"
          },
          items: [
            {
              value: "yes",
              text: "Yes"
            },
            {
              value: "no",
              text: "No"
            }
          ]
        }) }}

        {{ heading({
          caption: "Caption for address",
          text: "Heading for address",
          size: "l",
          level: 2
        }) }}

        <p class="nhsuk-body">Cras justo odio, dapibus ac facilisis in, egestas eget quam. Maecenas sed diam eget risus varius blandit sit amet non magna.</p>

        {% call fieldset({
          legend: {
            text: "What is your address?",
            size: "l"
          }
        }) %}
          {{ input({
            label: {
              text: "Address line 1"
            },
            id: "address-line-1",
            name: "address-line-1",
            autocomplete: "address-line1"
          }) }}

          {{ input({
            label: {
              text: "Address line 2 (optional)"
            },
            id: "address-line-2",
            name: "address-line-2",
            autocomplete: "address-line2"
          }) }}

          {{ input({
            label: {
              text: "Town or city"
            },
            classes: "nhsuk-u-width-two-thirds",
            id: "address-town",
            name: "address-town",
            autocomplete: "address-level2"
          }) }}

          {{ input({
            label: {
              text: "Postcode"
            },
            errorMessage: {
              text: "Enter a valid postcode"
            },
            id: "address-postcode",
            name: "address-postcode",
            autocomplete: "postal-code",
            width: 10
          }) }}

        {% endcall %}

        <div class="nhsuk-button-group">
          {{ button({
            text: "Continue"
          }) }}
        </div>
      </form>

    </div>
  </div>
{% endblock %}
