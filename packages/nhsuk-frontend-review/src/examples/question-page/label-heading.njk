{% extends "layouts/page.njk" %}

{% set mainClasses = "nhsuk-main-wrapper--s" %}
{% set pageHeading = "What is your home postcode?" %}

{% block beforeContent %}
  {{ backLink({
    href: baseUrl
  }) }}
{% endblock %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <form action="/form-handler" method="post" novalidate>

        {{ input({
          label: {
            heading: pageHeading,
            size: "l"
          },
          id: "postcode",
          name: "postcode",
          width: 10,
          autocomplete: "postal-code"
        }) }}

        {{ button({
          text: "Continue"
        }) }}

      </form>
    </div>
  </div>
{% endblock %}
