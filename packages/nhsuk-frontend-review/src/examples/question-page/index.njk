{% extends "layouts/page.njk" %}

{% set mainClasses = "nhsuk-main-wrapper--s" %}
{% set pageHeading = "Where do you live?" %}

{% block beforeContent %}
  {{ backLink({
    href: baseUrl
  }) }}
{% endblock %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      <form action="/form-handler" method="post" novalidate>

        {{ radios({
          fieldset: {
            legend: {
              heading: pageHeading,
              size: "l"
            }
          },
          id: "where-do-you-live",
          name: "whereDoYouLive",
          items: [
            {
              value: "england",
              text: "England"
            },
            {
              value: "scotland",
              text: "Scotland"
            },
            {
              value: "wales",
              text: "Wales"
            },
            {
              value: "northern-ireland",
              text: "Northern Ireland"
            }
          ]
        }) }}

        {{ button({
          text: "Continue"
        }) }}

      </form>
    </div>
  </div>
{% endblock %}
