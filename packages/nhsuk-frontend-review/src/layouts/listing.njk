{% extends "layouts/blank-full-width.njk" %}

{% set mainClasses = "nhsuk-u-padding-top-4" %}

{% block header %}
  {% include "partials/environment.njk" %}
  {% include "partials/banner-small.njk" %}
{% endblock %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        text: "NHS.UK frontend",
        href: baseUrl
      },
      {
        text: "Components",
        href: baseUrl ~ "#components"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <section class="nhsuk-main-wrapper nhsuk-main-wrapper--s">
    <div class="nhsuk-width-container">

      <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-two-thirds">
          <h1 class="nhsuk-heading-xl">{{ pageHeading }}</h1>
          <p class="nhsuk-body">These examples are used for automated tests and may not follow <a href="https://service-manual.nhs.uk">service manual</a> best practice.</p>
        </div>
      </div>

    </div>
  </section>

{% for fixture in fixtures %}
  {%- set exampleName = fixture.description ~ " " ~ fixture.name if fixture.description else fixture.name %}
  {%- set options = fixture.options %}
  {%- set classNamesColumn = "" %}
  {%- set isFullWidth = options.width is sameas(false) %}
  {%- set isReverse = options.layout == "background-blue" %}

  {#- Append grid column width classes #}
  {%- for width in ([options.width] if options.width is string else options.width | default([], true)) %}
    {%- set classNamesColumn = (classNamesColumn ~ " nhsuk-grid-column-" ~ width) | trim %}
  {% endfor %}

  {%- if not options.hidden %}
    {%- set htmlCode = uniqueHTML(fixture.html, loop.index) %}
    {%- set macroCode = getComponentMacro(component, fixture) %}

  <section id="{{ exampleName | slugify }}" class="nhsuk-main-wrapper app-wrapper {%- if options.layout %} app-wrapper--{{ options.layout }}{%- endif %}">
    <div class="nhsuk-width-container">
      <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-full">
          <div class="nhsuk-u-reading-width">
            <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2 nhsuk-u-margin-top-4">
              {{- name ~ " " ~ exampleName -}}
            </h2>
            <p class="nhsuk-body nhsuk-u-margin-bottom-6">
              {{ link({
                href: exampleName | slugify ~ "/",
                text: "Open this example in a new tab",
                visuallyHidden: {
                  text: name ~ " " ~ exampleName,
                  slots: { start: ": " }
                },
                classes: "nhsuk-link--no-visited-state" ~ (" nhsuk-link--reverse" if isReverse else ""),
                openInNewTab: true
              }) | trim | indent(14) }}
            </p>
          </div>
        </div>
      </div>
    {% if not isFullWidth %}
      <div class="nhsuk-grid-row">
        <div class="{{ classNamesColumn | default("nhsuk-grid-column-two-thirds", true) }}">
          {{ htmlCode | safe | indent(10) }}
        </div>
      </div>
    {% endif %}
    </div>
    {% if isFullWidth %}
      {{- htmlCode | safe | indent(4, true) }}
    {% endif %}
    <div class="nhsuk-width-container">
      <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-full">
          {% call details({
            summary: "Code",
            classes: "nhsuk-u-margin-top-4 nhsuk-u-margin-bottom-0",
            variant: "reverse" if isReverse
          }) %}
            <h3 class="nhsuk-heading-s">Markup</h3>
            {{ code({
              html: fixture.html | highlight("html"),
              variant: "reverse" if isReverse
            }) | trim }}

            <h3 class="nhsuk-heading-s">Macro</h3>
            {{ code({
              html: macroCode | highlight(["html", "njk"]),
              variant: "reverse" if isReverse,
              button: true
            }) | trim }}
          {% endcall %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}
{% endfor %}
{% endblock %}
