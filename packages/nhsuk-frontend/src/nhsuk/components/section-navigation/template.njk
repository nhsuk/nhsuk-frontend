{% from "nhsuk/components/badge/macro.njk" import badge as nhsukBadge %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-section-navigation" -%}

{%- if variant == "reverse" and (not params.classes or not "nhsuk-section-navigation--reverse" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-section-navigation--" ~ variant %}
{% endif %}

{%- if params.small and (not params.classes or not "nhsuk-section-navigation--small" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-section-navigation--small" %}
{% endif %}

{%- if params.direction and
  params.direction in ["horizontal", "vertical"] and (
    not params.classes or (
      not "nhsuk-section-navigation--horizontal" in params.classes and
      not "nhsuk-section-navigation--vertical" in params.classes
    )
  )
%}
  {% set classNames = classNames ~ " nhsuk-section-navigation--" ~ params.direction %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set items = params.items | select("mapping") | list if params.items else [] %}

{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    },
    "data-module": "nhsuk-section-navigation",
    "aria-label": params.ariaLabel | default("Section information", true)
  }) -}}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- macro _listItemBadge(params, parent) %}
  {{- nhsukBadge({
    text: params.text,
    html: params.html,
    visuallyHidden: params.visuallyHidden | default({
      text: params.visuallyHiddenText,
      placement: "start",
      slots: { start: ", ", end: ": " }
    }),
    variant: params.variant | default(parent.params.variant),
    small: params.small | default("nhsuk-section-navigation--small" in parent.classNames),
    classes: params.classes,
    attributes: params.attributes
  }) | trim }}
{%- endmacro -%}

{% set sectionNavigationHtml %}
<nav {{- attributesHtml | safe }}>
  <ul class="nhsuk-section-navigation__list">
  {% for item in items %}
    {% set itemInnerAttributesHtml %}
      {{- nhsukAttributes({
        class: "nhsuk-section-navigation__link" if item.href
          else "nhsuk-section-navigation__text",
        href: {
          value: item.href,
          optional: true
        },
        "aria-current": {
          value: ("page" if item.current else "true")
            if item.active or item.current
            else false,
          optional: true
        }
      }) -}}
    {% endset %}
    {% set itemInnerHtml %}
      {#- Wrap active links in strong element so users who override colours
          or styles still have some indicator of the current nav item. -#}
      {%- if item.active or item.current -%}
        <strong class="nhsuk-section-navigation__item-current-fallback">
          {{- item.html | safe if item.html else item.text -}}
        </strong>
        {{- _listItemBadge(item.badge, {
          params: params,
          classNames: classNames
        }) | trim -}}
      {%- else -%}
        {{- item.html | safe if item.html else item.text -}}
        {{- _listItemBadge(item.badge, {
          params: params,
          classNames: classNames
        }) | trim -}}
      {%- endif -%}
    {% endset %}
    <li class="nhsuk-section-navigation__item {%- if item.active or item.current %} nhsuk-section-navigation__item--current{% endif %} {%- if item.classes %} {{ item.classes }}{% endif %}" {{- nhsukAttributes(item.attributes) }}>
    {% if item.href %}
      <a {{- itemInnerAttributesHtml | safe }}>
        {{ nhsukContent({
          html: itemInnerHtml,
          slots: item.slots
        }) | trim | indent(8) }}
      </a>
    {% else %}
      <span {{- itemInnerAttributesHtml | safe }}>
        {{ nhsukContent({
          html: itemInnerHtml,
          slots: item.slots
        }) | trim | indent(8) }}
      </span>
    {% endif %}
    </li>
  {% endfor %}
  </ul>
</nav>
{% endset %}

{% if params.containerClasses %}
<div class="nhsuk-width-container {%- if params.containerClasses is string %} {{ params.containerClasses }}{% endif %}">
  {{ sectionNavigationHtml | safe | trim | indent(2) }}
</div>
{% else %}
  {{- sectionNavigationHtml | safe | trim }}
{% endif %}
