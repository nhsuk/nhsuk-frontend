{% from "nhsuk/components/link/macro.njk" import link as nhsukLink -%}

{{ nhsukLink({
  id: params.id,
  href: params.href | default("#maincontent", true),
  text: params.text | default("Skip to main content", true),
  html: caller() if caller else params.html,
  moduleName: "nhsuk-skip-link",
  className: "nhsuk-skip-link",
  classes: params.classes,
  attributes: params.attributes
}) | trim }}
