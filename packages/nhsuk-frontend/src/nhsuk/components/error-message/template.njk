{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/visually-hidden.njk" import nhsukVisuallyHidden %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-error-message" -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif -%}

{%- set innerHtml %}
{% if caller %}
  {{- caller() }}
{% elif params.html %}
  {{- params.html | safe }}
{% elif params.text %}
  {{- params.text }}
{% endif %}
{% endset -%}

<span class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
  {{ nhsukVisuallyHidden({
    text: params.visuallyHiddenText | default("Error"),
    slots: { end: ": " }
  }) | trim }}
  {{- innerHtml | safe | trim | indent(2) }}
</span>
