{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}
{% from "nhsuk/macros/slot.njk" import nhsukSlot %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-error-message" %}

{%- if params.classes %}
  {%- set classNames = classNames ~ " " ~ params.classes %}
{%- endif %}

{%- set content = {
  text: params.text,
  html: caller() if caller else params.html,
  visuallyHidden: {
    text: params.visuallyHiddenText | default("Error"),
    placement: "start",
    slots: { end: ": " }
  }
} %}

{{- nhsukSlot("before", params) -}}

<p class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
  {{ nhsukContent(content) | trim | indent(2) }}
</p>

{{- nhsukSlot("after", params) -}}
{{- "\n" | safe -}}
