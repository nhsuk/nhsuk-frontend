{% from "nhsuk/macros/attributes.njk" import nhsukAttributes -%}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-error-message" -%}

{%- if variant == "reverse" and (not params.classes or not "nhsuk-error-message--reverse" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-error-message--" ~ variant %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif -%}

{% set visuallyHiddenText = params.visuallyHiddenText | default("Error") -%}

{%- set errorMessageText %}
{% if caller %}
  {{- caller() }}
{% elif params.html %}
  {{- params.html | safe }}
{% elif params.text %}
  {{- params.text }}
{% endif %}
{% endset -%}

<span class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
  {% if visuallyHiddenText %}
  <span class="nhsuk-u-visually-hidden">{{ visuallyHiddenText }}: </span>
  {{- errorMessageText | safe | trim | indent(2) }}
  {% else %}
  {{ errorMessageText | safe | trim | indent(2) }}
  {% endif %}
</span>
