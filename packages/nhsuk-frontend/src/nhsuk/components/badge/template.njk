{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-badge" -%}

{%- if variant == "reverse" and (not params.classes or not "nhsuk-badge--reverse" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-badge--" ~ variant %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: {
      value: classNames if classNames else false,
      optional: true
    },
    id: {
      value: params.id,
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- set content = {
  text: params.text,
  html: params.html,
  visuallyHidden: params.visuallyHidden | default({
    text: params.visuallyHiddenText,
    placement: "start",
    slots: { end: ": " }
  })
} %}

{%- if caller or params.html or params.text is defined %}
<strong {{- attributesHtml | safe }}>
{%- if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{%- else %}
  {{- nhsukContent(content) | trim | indent(2) -}}
{% endif -%}
</strong>
{% endif %}
