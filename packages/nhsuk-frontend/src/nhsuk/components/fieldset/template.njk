{% from "nhsuk/components/legend/macro.njk" import legend as nhsukLegend %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-fieldset" -%}

{#- Support legend as string #}
{%- set legend = params.legend if params.legend is mapping and params.legend is not escaped else {
  text: params.legend if params.legend is string else undefined,
  html: params.legend if params.legend is escaped else undefined
} -%}

{#- Support caption as string #}
{%- set caption = legend.caption if legend.caption is mapping and legend.caption is not escaped else {
  text: legend.caption if legend.caption is string else undefined,
  html: legend.caption if legend.caption is escaped else undefined
} -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif -%}

<fieldset
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    },
    role: {
      value: params.role,
      optional: true
    },
    "aria-describedby": {
      value: params.describedBy if params.describedBy else false,
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(params.attributes) }}>
  {{ nhsukLegend({
    id: legend.id,
    text: legend.text,
    html: legend.html,
    visuallyHiddenText: legend.visuallyHiddenText,
    caption: {
      id: caption.id,
      text: caption.text,
      html: caption.html,
      placement: caption.placement,
      size: caption.size | default(legend.size),
      classes: caption.classes,
      attributes: caption.attributes
    },
    size: legend.size,
    heading: legend.heading,
    isPageHeading: legend.isPageHeading,
    classes: legend.classes,
    attributes: legend.attributes,
    variant: legend.variant | default(variant)
  }) | trim | indent(2) }}
{% if caller %}
  {{- caller() }}
{% elif params.html %}
  {{ params.html | safe | trim }}
{% endif %}
</fieldset>
