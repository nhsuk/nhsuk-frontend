{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/visually-hidden.njk" import nhsukVisuallyHidden %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-inset-text" -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif -%}

<div class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
  {{ nhsukVisuallyHidden(params.visuallyHiddenText | default("Information", true) ~ ": ") | trim }}
{% if caller %}
  {{- caller() }}
{% elif params.html %}
  {{ params.html | safe | trim | indent(2) }}
{% elif params.text %}
  <p>{{ params.text | trim | indent(2) }}</p>
{% endif %}
</div>
