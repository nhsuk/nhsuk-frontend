{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-inset-text" -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set innerHtml %}
  {%- if params.html %}
    {{- params.html | safe -}}
  {% elif params.text -%}
    <p>{{ params.text }}</p>
  {%- endif -%}
{% endset %}

{%- set content = {
  html: innerHtml,
  visuallyHidden: {
    text: params.visuallyHiddenText | default("Information", true),
    placement: "start",
    slots: { end: ": " }
  }
} -%}

<div class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
{% if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{ nhsukContent(content) | trim | indent(2) }}
{% endif %}
</div>
