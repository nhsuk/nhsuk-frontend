{% from "nhsuk/components/content/macro.njk" import content as nhsukContent %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-inset-text" -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set innerHtml %}
  {%- if params.html %}
    {{- params.html | safe -}}
  {% elif params.text -%}
    <p>{{ params.text }}</p>
  {%- endif -%}
{% endset %}

{%- set content = {
  id: params.id,
  html: innerHtml,
  visuallyHidden: {
    html: params.visuallyHiddenText | default("Information", true),
    placement: "start",
    suffix: ":"
  },
  classes: classNames,
  attributes: params.attributes,
  element: "div"
} -%}

{% if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{- nhsukContent(content) | trim }}
{% endif %}
