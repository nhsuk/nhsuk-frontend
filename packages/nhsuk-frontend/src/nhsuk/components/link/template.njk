{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set className = params.className | default("nhsuk-link", true) -%}
{%- set classNames = className if params.className not in ["", null, false] else "" -%}

{%- if variant == "reverse" and (not params.classes or not className ~ "--reverse" in params.classes) %}
  {% set classNames = (classNames ~ " " ~ className ~ "--" ~ variant) | trim %}
{% endif %}

{%- if params.classes %}
  {% set classNames = (classNames ~ " " ~ params.classes) | trim %}
{% endif -%}

{#- Determine type of element to use #}
{%- if not params.type %}
  {% set element = "a" %}
{% else %}
  {% set element = "button" %}
{% endif %}

{#- Define attributes that we can use across all element types #}
{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: {
      value: classNames if classNames else false,
      optional: true
    },
    id: {
      value: params.id,
      optional: true
    },
    name: {
      value: params.name if element == "button" else false,
      optional: true
    },
    "data-module": {
      value: params.moduleName,
      optional: true
    }
  }) -}}

  {% if element == "button" %}
    {{- nhsukAttributes({
      type: params.type | default("submit"),
      value: {
        value: params.value,
        optional: true
      }
    }) -}}
  {% elif element == "a" %}
    {{- nhsukAttributes({
      href: params.href | default("#"),
      target: {
        value: "_blank" if element == "a" and params.openInNewTab else false,
        optional: true
      }
    }) -}}
  {% endif %}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- set content = {
  text: params.text,
  html: params.html,
  visuallyHidden: params.visuallyHidden | default(params.visuallyHiddenText)
} -%}

<{{ element }} {{- attributesHtml | safe }}>
{% if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{ nhsukContent(content) | trim | indent(2) }}
{% endif %}
</{{ element }}>
