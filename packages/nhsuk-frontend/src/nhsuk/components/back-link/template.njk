{% from "nhsuk/components/content/macro.njk" import content as nhsukContent %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-back-link" -%}

{%- if variant == "reverse" and (not params.classes or not "nhsuk-back-link--reverse" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-back-link--" ~ variant %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set content = {
  id: params.id,
  text: params.text | default("Back", true),
  html: params.html,
  visuallyHidden: {
    html: params.visuallyHiddenText,
    placement: "start"
  },
  href: params.href,
  type: params.type,
  classes: classNames,
  attributes: params.attributes,
  element: params.element | default("a") if not (params.href or params.type)
} %}

{%- if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{- nhsukContent(content) | trim }}
{% endif %}
