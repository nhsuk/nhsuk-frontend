{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-back-link" -%}

{#- Support visually hidden content as string #}
{%- set visuallyHidden = params.visuallyHidden if params.visuallyHidden is mapping and params.visuallyHidden is not escaped else {
  text: params.visuallyHidden if params.visuallyHidden is string else params.visuallyHiddenText,
  html: params.visuallyHidden if params.visuallyHidden is escaped else undefined
} -%}

{%- if variant == "reverse" and (not params.classes or not "nhsuk-back-link--reverse" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-back-link--" ~ variant %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{#- Determine type of element to use, if not explicitly set #}
{%- if params.element %}
  {% set element = params.element | lower %}
{% else %}
  {% if params.href and not params.type %}
    {% set element = "a" %}
  {% else %}
    {% set element = "button" %}
  {% endif %}
{% endif %}

{#- Define attributes that we can use across all element types #}
{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    }
  }) -}}

  {% if element == "button" %}
    {{- nhsukAttributes({
      type: params.type | default("submit")
    }) -}}
  {% elif element == "a" %}
    {{- nhsukAttributes({
      href: params.href | default("#")
    }) -}}
  {% endif %}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- set content = {
  text: params.text | default("Back", true),
  html: params.html,
  visuallyHidden: {
    text: visuallyHidden.text,
    html: visuallyHidden.html,
    placement: visuallyHidden.placement | default("start")
  }
} -%}

<{{ element }} {{- attributesHtml | safe }}>
{% if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{ nhsukContent(content) | trim | indent(2) }}
{% endif %}
</{{ element }}>
