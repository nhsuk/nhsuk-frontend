{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/slot.njk" import nhsukSlot %}

{#- Set classes for this component #}
{% set classNames = "nhsuk-u-visually-hidden" %}

{#- Support params as string or number #}
{%- set params = params if params is mapping and params is not escaped else {
  text: params if params is string or params is number else undefined,
  html: params if params is escaped else undefined
} %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{#- Determine type of element to use, if not explicitly set #}
{%- if params.element %}
  {% set element = params.element | lower %}
{% else %}
  {% set element = "span" %}
{% endif %}

{%- set content = {
  text: params.text,
  html: caller() if caller else params.html,
  slots: params.slots
} %}

{%- set hasContent = true if content.html or content.text not in [undefined, null, false] and
  ((content.text is escaped or content.text is string or content.text is number) and content.text | string | length) else false %}

{{- nhsukSlot("before", content) -}}

{%- if hasContent %}
<{{ element }} class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
  {{- nhsukSlot("start", content) -}}

  {% if content.html %}
    {{- content.html | safe -}}
  {% elif content.text is escaped %}
    {{- content.text | safe -}}
  {% elif content.text is string or content.text is number %}
    {{- content.text | string -}}
  {% endif %}

  {{- nhsukSlot("end", content) -}}
</{{ element }}>
{% endif %}

{{- nhsukSlot("after", content) -}}
