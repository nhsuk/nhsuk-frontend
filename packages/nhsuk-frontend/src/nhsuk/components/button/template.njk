{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/icon.njk" import nhsukIcon %}
{% from "nhsuk/macros/slot.njk" import nhsukSlot %}

{#- Set variant for this component #}
{%- set variant = params.variant -%}

{#- Set classes for this component #}
{%- set className = params.className | default("nhsuk-button", true) -%}
{%- set classNames = className if params.className not in ["", null, false] else "" -%}

{%- if variant and
  variant in ["brand", "login", "reverse", "secondary", "secondary-solid", "warning"] and (
    not params.classes or (
      not " " ~ className ~ "--brand" in params.classes and
      not " " ~ className ~ "--login" in params.classes and
      not " " ~ className ~ "--reverse" in params.classes and
      not " " ~ className ~ "--secondary" in params.classes and
      not " " ~ className ~ "--secondary-solid" in params.classes and
      not " " ~ className ~ "--warning" in params.classes
    )
  )
%}
  {% set classNames = (classNames ~ " " ~ className ~ "--" ~ variant) | trim %}
{% endif %}

{%- if params.icon and (not params.classes or not className ~ "--icon" in params.classes) %}
  {% set classNames = (classNames ~ " " ~ className ~ "--icon") | trim %}
{% endif %}

{%- if params.small and (not params.classes or not className ~ "--small" in params.classes) %}
  {% set classNames = (classNames ~ " " ~ className ~ "--small") | trim %}
{% endif %}

{%- if params.classes %}
  {% set classNames = (classNames ~ " " ~ params.classes) | trim %}
{% endif %}

{#- Determine type of element to use, if not explicitly set #}
{%- if params.element %}
  {% set element = params.element | lower %}
{% else %}
  {% if params.href and not params.type %}
    {% set element = "a" %}
  {% else %}
    {% set element = "button" %}
  {% endif %}
{% endif %}

{%- set icon = params.icon -%}

{%- if icon and icon is string %}
  {% set icon = {
    name: icon,
    placement: "start"
  } %}
{% endif -%}

{#- Define attributes that we can use across all element types #}
{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: {
      value: classNames if classNames else false,
      optional: true
    },
    id: {
      value: params.id,
      optional: true
    },
    name: {
      value: params.name if element == "button" or element == "input" else false,
      optional: true
    },
    "data-module": "nhsuk-button",
    "data-prevent-double-click": {
      value: params.preventDoubleClick | string
        if params.preventDoubleClick in [true, false]
        else false,
      optional: true
    }
  }) -}}

  {% if element == "button" or element == "input" %}
    {{- nhsukAttributes({
      type: params.type | default("submit"),
      value: {
        value: params.text if element == "input" else params.value,
        optional: true
      },
      disabled: {
        value: params.disabled,
        optional: true
      },
      "aria-label": {
        value: params.ariaLabel,
        optional: true
      },
      "aria-disabled": {
        value: "true" if params.disabled else false,
        optional: true
      }
    }) -}}
  {% elif element == "a" %}
    {{- nhsukAttributes({
      href: params.href | default("#"),
      role: "button",
      draggable: "false",
      "aria-label": {
        value: params.ariaLabel,
        optional: true
      }
    }) -}}
  {% endif %}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- set buttonText = params.html | safe if params.html else params.text %}
{%- set buttonIcon = icon.html if icon.html else (nhsukIcon(icon.name) if icon.name) %}

{%- set innerHtml %}
{% if buttonIcon and icon.placement == "start" %}
  {{ buttonIcon | trim | indent(2) }}
{% endif %}
{% if caller %}
  {{- nhsukSlot("start", params) -}}
  {{- caller() }}
  {{- nhsukSlot("end", params) -}}
{% elif (params.text or params.html) and buttonIcon %}
  <span class="nhsuk-button__content">
    {{- nhsukSlot("start", params) -}}
    {{- buttonText | trim | indent(2) -}}
    {{- nhsukSlot("end", params) -}}
  </span>
{% elif params.text or params.html %}
  {{- nhsukSlot("start", params) -}}
  {{ buttonText | trim | indent(2) }}
  {{- nhsukSlot("end", params) -}}
{% endif %}
{% if buttonIcon and icon.placement == "end" %}
  {{ buttonIcon | trim | indent(2) }}
{% endif %}
{% endset %}

{{- nhsukSlot("before", params) -}}

{%- if element == "a" %}
<a {{- attributesHtml | safe }}>
  {{ innerHtml | safe | trim }}
</a>
{% elif element == "button" %}
<button {{- attributesHtml | safe }}>
  {{ innerHtml | safe | trim }}
</button>
{% elif element == "input" %}
<input {{- attributesHtml | safe }}>
{% endif %}

{{- nhsukSlot("after", params) -}}
