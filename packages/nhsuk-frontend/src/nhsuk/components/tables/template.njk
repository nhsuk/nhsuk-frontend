{% from "nhsuk/components/card/macro.njk" import card as nhsukCard %}
{% from "nhsuk/components/heading/macro.njk" import heading as nhsukHeading %}
{% from "nhsuk/components/link/macro.njk" import link as nhsukLink %}
{% from "nhsuk/components/scroll/macro.njk" import scroll as nhsukScroll %}
{% from "nhsuk/components/visually-hidden/macro.njk" import visuallyHidden as nhsukVisuallyHidden %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}
{% from "nhsuk/macros/i18n.njk" import nhsukI18nAttributes %}

{#- Set variant for this component #}
{%- set variant = params.variant %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-table" %}
{%- set classNamesCaption = "nhsuk-table__caption" %}

{#- Support caption as string (with deprecated options) #}
{%- set caption = params.caption if params.caption is mapping and params.caption is not escaped else {
  text: params.caption if params.caption is string else undefined,
  html: params.caption if params.caption is escaped else undefined,
  size: params.captionSize,
  classes: params.captionClasses
} %}

{#- Support heading caption as string #}
{%- set headingCaption = caption.caption if caption.caption is mapping and caption.caption is not escaped else {
  text: caption.caption if caption.caption is string else undefined,
  html: caption.caption if caption.caption is escaped else undefined
} %}

{%- set isResponsive = true if params.classes and (
  "nhsuk-table--responsive" in params.classes or
  "nhsuk-table-responsive" in params.classes
) else false %}

{%- set isSortable = true if params.classes and (
  "nhsuk-table--sortable" in params.classes
) else false %}

{%- set isSortableOnServer = false %}

{#- Support table head as array #}
{%- set head = params.head if params.head is mapping and params.head is not escaped else {
  items: params.head if params.head | length else []
} %}

{#- Support table rows as arrays or mappings #}
{%- set rows = params.rows
  | reject("undefined")
  | reject("sameas", none)
  | reject("sameas", false)
  | reject("sameas", true)
  | reject("number")
  | list if params.rows | length else [] %}

{%- if variant == "reverse" and (
  not params.classes or (
    not "nhsuk-table--reverse" in params.classes and
    not "nhsuk-table-responsive--reverse" in params.classes
  )
) %}
  {%- set classNames = classNames ~ " nhsuk-table--" ~ variant %}
{%- endif %}

{%- if params.compact and (not params.classes or not "nhsuk-table--compact" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-table--compact" %}
{%- endif %}

{%- if params.responsive and not isResponsive %}
  {%- set isResponsive = true %}
  {%- set classNames = classNames ~ " nhsuk-table--responsive" %}
{%- endif %}

{#- Determine if the table is sortable #}
{%- for item in head.items %}
  {%- set isSortable = true if item.sort else isSortable %}
  {%- set isSortableOnServer = true if isSortable and item.href else isSortableOnServer %}
{%- endfor %}

{%- if isSortable and (not params.classes or not "nhsuk-table--sortable" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-table--sortable" %}
{%- endif %}

{%- if params.striped and (not params.classes or not "nhsuk-table--striped" in params.classes) and rows | length > 1 %}
  {%- set classNames = classNames ~ " nhsuk-table--striped" %}
{%- endif %}

{%- if params.border is sameas(false) and not (params.classes and "nhsuk-table--no-border" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-table--no-border" %}
{% elif params.lastRowBorder is sameas(false) and not (params.classes and "nhsuk-table--no-last-row-border" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-table--no-last-row-border" %}
{%- endif %}

{%- if params.classes or params.tableClasses %}
  {%- set classNames = classNames ~ " " ~ (params.classes or params.tableClasses) %}
{%- endif %}

{%- set captionId = caption.id | default(params.id ~ "-caption" if params.scroll and params.id else undefined) | default(("table-" ~ caption.text | replace(" ", "-") | lower | truncate(40, true, "") ~ "-caption") if params.scroll and caption.text else undefined) %}
{%- set captionVisuallyHiddenText = caption.visuallyHiddenText | default("Column headers are sortable" if isSortable else undefined) %}

{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    },
    "data-module": {
      value: "nhsuk-table" if isSortable and not isSortableOnServer else false,
      optional: true
    }
  }) -}}

  {{- nhsukI18nAttributes({
    key: "sort-announcement",
    message: params.sortAnnouncementText
  }) -}}

  {{- nhsukI18nAttributes({
    key: "ascending",
    message: params.ascendingText
  }) -}}

  {{- nhsukI18nAttributes({
    key: "descending",
    message: params.descendingText
  }) -}}

  {{- nhsukAttributes({
    role: {
      value: "table" if isResponsive else false,
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- macro _tableCell(item, parent) %}
{%- set element = "th" if item.scope else "td" %}
{%- set classNameCell = "nhsuk-table__header" if item.scope else "nhsuk-table__cell" %}
{%- set classNamesCell = classNameCell %}

{%- if item.format == "numeric" and (not item.classes or not classNameCell ~ "--" ~ item.format in item.classes) %}
  {%- set classNamesCell = classNamesCell ~ " " ~ classNameCell ~ "--" ~ item.format %}
{%- endif %}

{%- if item.align and
  item.align in ["left", "centre", "right"] and (
    not item.classes or (
      not "nhsuk-u-text-align-left" in item.classes and
      not "nhsuk-u-text-align-centre" in item.classes and
      not "nhsuk-u-text-align-right" in item.classes
    )
  )
%}
  {%- set classNamesCell = classNamesCell ~ " nhsuk-u-text-align-" ~ item.align %}
{%- endif %}

{%- if item.width and (not item.classes or not "nhsuk-u-width-" ~ item.width in item.classes) %}
  {%- set classNamesCell = classNamesCell ~ " nhsuk-u-width-" ~ item.width %}
{%- endif %}

{%- if item.classes %}
  {%- set classNamesCell = classNamesCell ~ " " ~ item.classes %}
{%- endif %}

{%- set innerHtml %}
{% if item.href %}
  {{- nhsukLink({
    href: item.href,
    html: nhsukContent(item),
    openInNewTab: item.openInNewTab
  }) | trim -}}
{% else %}
  {{- nhsukContent(item) | trim -}}
{% endif %}
{%- endset -%}

<{{ element }}
  {{- nhsukAttributes({
    class: classNamesCell,
    scope: {
      value: item.scope,
      optional: true
    },
    role: {
      value: item.role,
      optional: true
    },
    colspan: {
      value: item.colspan,
      optional: true
    },
    rowspan: {
      value: item.rowspan,
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(item.attributes) }}>
{% if parent.isResponsive and parent.section == "body" and (parent.header.text or parent.header.html or item.header) %}
  <span class="nhsuk-table__heading" aria-hidden="true">
    {{- nhsukContent({
      text: parent.header.text if not item.header else item.header,
      html: parent.header.html if not item.header else undefined,
      slots: { end: " " }
    }) | indent(2) -}}
  </span>
  {%- if item.html -%}
    <span>{{ innerHtml | safe | indent(2) }}</span>
  {% else %}
    {{- innerHtml | safe | indent(2) }}
  {% endif %}
{% else %}
  {{ innerHtml | safe | indent(2) }}
{% endif %}
</{{ element }}>
{%- endmacro %}

{%- macro _tableRow(row, parent) %}
{#- Support table row as array #}
{%- set row = row if row is mapping and row is not escaped else {
  items: row if row | length else []
} -%}

<tr
  {{- nhsukAttributes({
    class: "nhsuk-table__row" ~ (" " ~ row.classes if row.classes else ""),
    id: {
      value: row.id,
      optional: true
    },
    role: {
      value: "row" if parent.isResponsive else false,
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(row.attributes) }}>
  {% for item in row.items %}
    {%- if item is defined and item is not none and item is not sameas(false) %}

      {#- Set table header default (optional) #}
      {%- set header = parent.head.items[loop.index0]
        if parent.section == "body"
        else undefined %}

      {#- Support table header as string or number (optional) #}
      {%- if header is string or header is number or header is escaped %}
        {%- set header = {
          text: header if header is not escaped else undefined,
          html: header if header is escaped else undefined
        } %}
      {%- endif %}

      {#- Support table data as defined value #}
      {%- set data = item if item is mapping and item is not escaped else {
        text: item if item is not escaped else undefined,
        html: item if item is escaped else undefined
      } %}

      {%- set scope = "col" if parent.section == "head" else (
        "row" if loop.first and parent.params.firstCellIsHeader else undefined
      ) %}

      {%- set attributesHtml %}
        {%- if parent.section == "head" %}
          {%- if parent.isSortable %}
            {{- nhsukAttributes({
              "data-sort": {
                value: true if data.sort and (data.sort is string or data.sort is sameas(true)) else false,
                optional: true
              },
              "data-sort-next": {
                value: data.sortNext if data.sortNext and data.sortNext is string and not parent.isSortableOnServer else false,
                optional: true
              },
              "aria-sort": {
                value: data.sort if data.sort and data.sort is string and data.sort != "none" else false,
                optional: true
              }
            }) -}}
          {% endif %}
        {%- else %}
          {{- nhsukAttributes({
            "data-sort-value": {
              value: data.sortValue if data.sortValue else false,
              optional: true
            }
          }) -}}
        {% endif %}

        {{- nhsukAttributes(data.attributes) -}}
      {% endset %}

      {{- _tableCell({
        text: data.text,
        html: data.html,
        header: data.header,
        visuallyHiddenText: data.visuallyHiddenText,
        format: data.format | default(header.format),
        href: data.href,
        openInNewTab: data.openInNewTab,
        scope: scope,
        role: (
          "columnheader" if scope == "col" else (
            "rowheader" if scope == "row" else "cell"
          )
        ) if parent.isResponsive else undefined,
        colspan: data.colspan if not parent.isResponsive else undefined,
        rowspan: data.rowspan,
        align: data.align | default("right" if data.format == "string" and header.format == "numeric" else header.align),
        width: data.width,
        classes: data.classes,
        attributes: attributesHtml
      }, {
        header: header,
        section: parent.section,
        isResponsive: parent.isResponsive
      }) | trim | indent(2, true) }}
    {% endif %}
  {% endfor %}
</tr>
{%- endmacro %}

{%- set tableHtml %}
<table {{- attributesHtml | safe }}>
{% if not (caption.text or caption.html) and captionVisuallyHiddenText %}
  {{ nhsukVisuallyHidden({
    id: captionId,
    text: captionVisuallyHiddenText,
    classes: caption.classes,
    attributes: caption.attributes,
    element: "caption"
  }) | trim | indent(2) }}
{% elif caption.text or caption.html %}
  {{ nhsukHeading({
    id: captionId,
    text: caption.text,
    html: caption.html,
    visuallyHiddenText: "(" ~ captionVisuallyHiddenText ~ ")" if captionVisuallyHiddenText else undefined,
    caption: {
      id: headingCaption.id,
      text: headingCaption.text,
      html: headingCaption.html,
      placement: headingCaption.placement if not headingCaption.placement or
        headingCaption.placement in ["start", "end"] else undefined,
      size: headingCaption.size | default(caption.size),
      classes: headingCaption.classes,
      attributes: headingCaption.attributes
    },
    size: caption.size,
    sizes: ["s", "m", "l", "xl"],
    className: classNamesCaption,
    classPrefix: classNamesCaption ~ "--",
    classes: caption.classes,
    attributes: caption.attributes,
    element: "caption"
  }) | trim | indent(2) }}
{% endif %}
{% if head.items | length %}
  <thead class="nhsuk-table__head" {%- if isResponsive %} role="rowgroup" {%- endif %}>
    {{ _tableRow(head, {
      params: params,
      head: head,
      section: "head",
      isResponsive: isResponsive,
      isSortable: isSortable,
      isSortableOnServer: isSortableOnServer
    }) | trim | indent(4) }}
  </thead>
{% endif %}
{% if rows | length %}
  <tbody class="nhsuk-table__body">
  {% for row in rows %}
    {{ _tableRow(row, {
      params: params,
      head: head,
      section: "body",
      isResponsive: isResponsive
    }) | trim | indent(4) }}
  {% endfor %}
  </tbody>
{% endif %}
</table>
{% endset %}

{%- if params.scroll %}
  {%- set tableHtml = nhsukScroll({
    html: tableHtml | trim,
    labelledBy: captionId,
    variant: variant
  }) | trim %}
{% endif %}

{%- if params.card or params.panel %}
  {%- set cardHeading = params.card.heading if params.card.heading is mapping and params.card.heading is not escaped else {
    text: params.card.heading if params.card.heading is string else params.heading,
    html: params.card.heading if params.card.heading is escaped else undefined,
    level: params.headingLevel
  } %}

  {%- call nhsukCard({
    id: params.card.id,
    heading: cardHeading,
    href: params.card.href,
    openInNewTab: params.card.openInNewTab,
    actions: params.card.actions,
    classes: params.panelClasses | default(params.card.classes),
    attributes: params.card.attributes,
    variant: params.card.variant | default("feature" if params.panel else undefined)
  }) %}
    {{- tableHtml | safe | trim | indent(4, true) }}
  {%- endcall %}
{%- else %}
  {{- tableHtml | safe | trim }}
{% endif %}
