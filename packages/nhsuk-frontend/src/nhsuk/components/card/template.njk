{% from "nhsuk/components/heading/macro.njk" import heading %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/icon.njk" import nhsukIcon %}
{% from "nhsuk/components/card/action/macro.njk" import cardAction %}

{#- Set variant or (deprecated) type for this component #}
{%- set variant = params.variant or params.type -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-card" -%}
{%- set classNamesHeading = "nhsuk-card__heading" -%}

{%- if params.clickable %}
  {% set classNames = classNames ~ " nhsuk-card--clickable" %}
{% endif %}

{%- if params.feature %}
  {% set classNames = classNames ~ " nhsuk-card--feature" %}
{% endif %}

{%- if params.primary %}
  {% set classNames = classNames ~ " nhsuk-card--primary" %}
{% endif %}

{%- if params.secondary %}
  {% set classNames = classNames ~ " nhsuk-card--secondary" %}
{% endif %}

{%- if params.warning %}
  {% set classNames = classNames ~ " nhsuk-card--warning" %}
{% endif %}

{%- if variant and
  variant in ["feature", "primary", "secondary", "warning"] and (
    not params.classes or (
      not "nhsuk-card--feature" in params.classes and
      not "nhsuk-card--primary" in params.classes and
      not "nhsuk-card--secondary" in params.classes and
      not "nhsuk-card--warning" in params.classes
    )
  )
%}
  {% set classNames = classNames ~ " nhsuk-card--" ~ variant %}
{% endif %}

{%- set isCareCard = true if variant
  and variant in ["non-urgent", "urgent", "emergency"]
  and (params.heading or params.headingHtml)
  else false -%}

{%- if isCareCard and (
    not params.classes or (
      not "nhsuk-card--care--non-urgent" in params.classes and
      not "nhsuk-card--care--urgent" in params.classes and
      not "nhsuk-card--care--emergency" in params.classes
    )
  )
%}
  {% set classNames = classNames ~ " nhsuk-card--care nhsuk-card--care--" ~ variant %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set actions = params.actions.items | select("mapping") if params.actions.items | length else [] %}

{%- set image = {
  src: params.imgURL,
  alt: params.imgALT
} if (params.imgURL or params.imgALT) else params.image %}

{%- macro _careHeading(params, classNamesHeading) %}
{%- set headingHtml %}
<span class="nhsuk-card--care__arrow" aria-hidden="true"></span>
{% endset -%}

{%- set headingVisuallyHiddenText %}
  {%- if params.headingVisuallyHiddenText -%}
    {{ params.headingVisuallyHiddenText }}
  {%- elif variant == "emergency" -%}
    Immediate action required
  {%- elif variant == "urgent" -%}
    Urgent advice
  {%- else -%}
    Non-urgent advice
  {%- endif -%}
{% endset -%}

{{ _cardHeading({
  heading: params.heading,
  headingHtml: headingHtml,
  headingVisuallyHiddenText: headingVisuallyHiddenText,
  headingLevel: params.headingLevel,
  headingSize: params.headingSize,
  headingClasses: params.headingClasses,
  headingId: params.headingId,
  href: params.href
}, classNamesHeading) | trim }}
{% endmacro -%}

{%- macro _cardHeading(params, classNamesHeading) %}
{% if params.heading %}
{% call heading({
  level: params.headingLevel | default(2),
  size: params.headingSize,
  classes: params.headingClasses,
  className: classNamesHeading,
  classPrefix: "nhsuk-heading-",
  id: params.headingId
}) %}
{% if params.href and not "nhsuk-card--feature" in classNames %}
  <a class="nhsuk-card__link" href="{{ params.href }}">
    {{- params.heading -}}
  </a>
{%- elif params.headingVisuallyHiddenText %}
  <span role="text">
    <span class="nhsuk-u-visually-hidden">{{- params.headingVisuallyHiddenText -}}:</span> {{ params.heading }}
  </span>
{%- else %}
  {{ params.heading }}
{%- endif %}
{%- endcall %}
{% endif %}
{% if params.headingHtml %}
  {{- params.headingHtml | safe | trim }}
{% endif %}
{% endmacro -%}

<div class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %}
  {{- nhsukAttributes(params.attributes) }}>
{% if image.html %}
  {{ image.html | safe | trim | indent(2) }}
{% elif image.src %}
  <img {{- nhsukAttributes({
    class: "nhsuk-card__img",
    src: image.src,
    alt: image.alt
  }) }}>
{% endif %}
{% if isCareCard or actions | length %}
  <div class="nhsuk-card__heading-container">
  {% if isCareCard %}
    {{ _careHeading(params, classNamesHeading) | trim | indent(4) }}
  {% elif params.heading or params.headingHtml %}
    {{ _cardHeading(params, classNamesHeading) | trim | indent(4) }}
  {% endif %}
    {% if actions | length == 1 %}
    <div class="nhsuk-card__actions {%- if params.actions.classes %} {{ params.actions.classes }}{% endif %}">
      {{ cardAction(actions[0], {
        params: params
      }) | trim | indent(6) }}
    </div>
    {% elif actions | length %}
    <ul class="nhsuk-card__actions {%- if params.actions.classes %} {{ params.actions.classes }}{% endif %}">
      {% for action in actions %}
      <li class="nhsuk-card__action">
        {{ cardAction(action, {
          params: params
        }) | trim | indent(8) }}
      </li>
      {% endfor %}
    </ul>
  {% endif %}
  </div>
{% endif %}
  <div class="nhsuk-card__content">
  {% if not isCareCard and not actions | length and (params.heading or params.headingHtml) %}
    {{ _cardHeading(params, classNamesHeading) | trim | indent(4) }}
  {% endif %}
  {% if caller %}
    {{- caller() }}
  {% elif params.descriptionHtml %}
    {{ params.descriptionHtml | safe | trim | indent(4) }}
  {% elif params.description %}
    <p class="nhsuk-card__description">
      {{- params.description -}}
    </p>
  {% endif %}
  {% if "nhsuk-card--primary" in classNames %}
    {{ nhsukIcon("chevron-right-circle") | trim | indent(4) }}
  {% endif %}
  </div>
</div>
