{% from "nhsuk/components/content/macro.njk" import content as nhsukContent %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-link" -%}

{#- Support heading as string #}
{%- set heading = parent.params.heading if parent.params.heading is mapping and parent.params.heading is not escaped else {
  text: parent.params.heading if parent.params.heading is string else undefined,
  html: parent.params.heading if parent.params.heading is escaped else undefined
} -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set visuallyHiddenHtml %}
  {%- if params.visuallyHiddenText %} {{ params.visuallyHiddenText }}{% endif -%}
  {%- if heading.text or heading.html %} ({{ heading.html | safe if heading.html else heading.text }}){% endif -%}
{% endset %}

{%- set content = {
  id: params.id,
  text: params.text,
  html: params.html,
  visuallyHidden: {
    html: visuallyHiddenHtml | trim,
    placement: "end"
  } if params.visuallyHiddenText or heading.text or heading.html,
  href: params.href,
  type: params.type,
  name: params.name,
  value: params.value,
  classes: classNames,
  attributes: params.attributes
} %}

{%- if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{- nhsukContent(content) | trim }}
{% endif %}
