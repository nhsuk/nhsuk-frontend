{% from "nhsuk/components/heading/macro.njk" import heading %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set variant or (deprecated) type for this component #}
{%- set variant = params.variant or params.type -%}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-notification-banner" -%}

{#- Support title as string (with deprecated options) #}
{%- set titleOptions = params.title if params.title is mapping and params.title is not escaped else {
  id: params.titleId,
  text: params.title if params.title is string else params.titleText,
  html: params.title if params.title is escaped else params.titleHtml,
  level: params.titleHeadingLevel
} -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- if variant == "success" and (not params.classes or not "nhsuk-notification-banner--success" in params.classes) %}
  {% set classNames = classNames ~ " nhsuk-notification-banner--" ~ variant %}
{% endif %}

{%- if params.role %}
  {% set role = params.role %}
{% elif variant == "success" %}
  {#- If variant is success, add `role="alert"` to prioritise the information in the notification banner to users of assistive technologies -#}
  {% set role = "alert" %}
{% else %}
  {#- Otherwise add `role="region"` to make the notification banner a landmark to help users of assistive technologies to navigate to the banner -#}
  {% set role = "region" %}
{% endif %}

<div
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    },
    "data-module": "nhsuk-notification-banner",
    "data-disable-auto-focus": {
      value: params.disableAutoFocus | string
        if params.disableAutoFocus in [true, false]
        else false,
      optional: true
    },
    role: role,
    "aria-labelledby": titleOptions.id | default("nhsuk-notification-banner-title", true)
  }) -}}

  {{- nhsukAttributes(params.attributes) -}}>
  <div class="nhsuk-notification-banner__header">
    {{ heading({
      id: titleOptions.id | default("nhsuk-notification-banner-title", true),
      text: titleOptions.text | default("Success" if variant == "success" else "Important"),
      html: titleOptions.html,
      visuallyHiddenText: titleOptions.visuallyHiddenText,
      level: titleOptions.level | default(2),
      className: "nhsuk-notification-banner__title",
      classes: titleOptions.classes,
      attributes: titleOptions.attributes
    }) | trim | indent(4) }}
  </div>
  <div class="nhsuk-notification-banner__content">
  {% if params.heading %}
    {{ heading({
      id: params.heading.id,
      text: params.heading.text,
      html: params.heading.html,
      visuallyHiddenText: params.heading.visuallyHiddenText,
      caption: params.heading.caption,
      href: params.heading.href,
      level: params.heading.level | default(3),
      className: "nhsuk-notification-banner__heading",
      classes: params.heading.classes,
      attributes: params.heading.attributes,
      element: params.heading.element
    }) | trim | indent(4) }}
  {% endif %}
  {% if caller %}
    {{- caller() }}
  {% elif params.html %}
    {{ params.html | safe | trim | indent(4) }}
  {% elif params.text and not params.heading %}
    <p class="nhsuk-notification-banner__heading">
      {{ params.text | trim | indent(6) }}
    </p>
  {% elif params.text %}
    <p class="nhsuk-body">
      {{ params.text | trim | indent(6) }}
    </p>
  {% endif %}
  </div>
</div>
