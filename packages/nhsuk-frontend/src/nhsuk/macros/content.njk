{% from "nhsuk/components/visually-hidden/macro.njk" import visuallyHidden as nhsukVisuallyHidden %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#-
  Renders text, HTML or visually hidden content
#}
{% macro nhsukContent(params = {}) -%}

{#- Support params as string or number #}
{%- set params = params if params is mapping and params is not escaped else {
  text: params if params is string or params is number else undefined,
  html: params if params is escaped else undefined
} %}

{#- Support visually hidden content as string or number #}
{%- set visuallyHidden = params.visuallyHidden if params.visuallyHidden is mapping and params.visuallyHidden is not escaped else {
  text: params.visuallyHidden if params.visuallyHidden is string or params.visuallyHidden is number else params.visuallyHiddenText,
  html: params.visuallyHidden if params.visuallyHidden is escaped else undefined
} %}

{%- set content = {
  text: params.text,
  html: caller() if caller else params.html,
  visuallyHidden: visuallyHidden
} %}

{%- set hasContent = true if content.html or content.text not in [undefined, null, false] and
  ((content.text is string or content.text is number) and content.text | string | length) else false %}

{%- set hasVisuallyHidden = true if content.visuallyHidden.html or content.visuallyHidden.text not in [undefined, null, false] and
  ((content.visuallyHidden.text is string or content.visuallyHidden.text is number) and content.visuallyHidden.text | string | length) else false %}

{#- Set visually hidden slots based on placement #}
{%- set visuallyHiddenSlots = content.visuallyHidden.slots if content.visuallyHidden.slots is mapping and content.visuallyHidden.slots is not escaped else {
  start: " " if hasContent and (content.visuallyHidden.placement == "end" or not content.visuallyHidden.placement) else undefined,
  end: " " if hasContent and content.visuallyHidden.placement == "start" else undefined
} %}

{%- if hasContent or hasVisuallyHidden %}
{%- set visuallyHiddenHtml %}
  {{- nhsukVisuallyHidden({
    id: content.visuallyHidden.id,
    text: content.visuallyHidden.text,
    html: content.visuallyHidden.html,
    classes: content.visuallyHidden.classes,
    attributes: content.visuallyHidden.attributes,
    placement: content.visuallyHidden.placement,
    element: content.visuallyHidden.element,
    slots: visuallyHiddenSlots
  }) | trim -}}
{% endset %}

{%- set innerHtml %}
  {%- if content.visuallyHidden.placement == "start" %}
    {{- visuallyHiddenHtml | safe | trim -}}
  {% endif %}

  {%- if content.html %}
    {{- content.html | safe -}}
  {% elif content.text is string or content.text is number %}
    {{- content.text | string -}}
  {% endif %}

  {%- if content.visuallyHidden.placement == "end" or (hasVisuallyHidden and not content.visuallyHidden.placement) %}
    {{- visuallyHiddenHtml | safe | trim -}}
  {% endif -%}
{% endset %}

{%- if content.visuallyHidden.placement == "before" %}
  {{- visuallyHiddenHtml | safe | trim -}}

  {{- "\n" | safe if hasContent -}}
{% endif %}

{{- innerHtml | safe -}}

{%- if content.visuallyHidden.placement == "after" %}
  {{- "\n" | safe if hasContent -}}

  {{- visuallyHiddenHtml | safe | trim -}}
{% endif %}
{% endif %}
{%- endmacro %}
