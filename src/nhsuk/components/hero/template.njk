{% from "nhsuk/components/heading/macro.njk" import heading %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-hero" -%}
{%- set classNamesHeading = "nhsuk-hero__heading" -%}
{%- set classNamesColumn = "nhsuk-grid-column" -%}

{%- set image = {
  src: params.imageURL
} if params.imageURL else params.image %}

{%- if image.src %}
  {% set classNames = classNames ~ " nhsuk-hero--image" ~
    (" nhsuk-hero--image-description" if params.heading else "") %}
{% elif params.border != false  %}
  {% set classNames = classNames ~ " nhsuk-hero--border" %}
{% endif %}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set contentWidth = params.contentWidth | default("two-thirds") %}

{%- if contentWidth in [
  "one-quarter",
  "one-third",
  "one-half",
  "two-thirds",
  "three-quarters",
  "full"
] %}
  {% set classNamesColumn = classNamesColumn ~ "-" ~ contentWidth %}
{% endif %}

{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    }
  }) -}}

  {% if image.src %}
    {{- nhsukAttributes({
      style: ("background-image: url('" ~ image.src | escape ~ "');") | safe
    }) -}}
  {% endif %}

  {{- nhsukAttributes(params.attributes) -}}
{% endset -%}

{% set innerHtml %}
  <div class="nhsuk-width-container {%- if params.containerClasses %} {{ params.containerClasses }}{% endif %}">
    <div class="nhsuk-grid-row">
      <div class="{{ classNamesColumn }}">
        <div class="nhsuk-hero__content">
        {% if params.heading %}
          {{ heading({
            text: params.heading,
            level: params.headingLevel,
            size: params.headingSize,
            classes: classNamesHeading
              ~ ("nhsuk-u-margin-bottom-0" if not (caller or params.text or params.html) else "")
              ~ (" " ~ params.headingClasses if params.headingClasses)
          }) | trim | indent(10) }}
        {% endif %}
        {% if caller %}
          {{- caller() }}
        {% elif params.html %}
          {{ params.html | safe | trim | indent(10) }}
        {% elif params.text %}
          <p class="nhsuk-body-l nhsuk-u-margin-bottom-0">
            {{- params.text | trim | indent(10) -}}
          </p>
        {% endif %}
        {% if image.src %}
          <span class="nhsuk-hero__arrow" aria-hidden="true"></span>
        {% endif %}
        </div>
      </div>
      {% if params.secondaryHtml %}
        <div class="nhsuk-grid-column-one-half">
          {{ params.secondaryHtml | safe | trim | indent(10) }}
        </div>
      {% endif %}
    </div>
  </div>
{% endset -%}

<section {{- attributesHtml | safe }}>
{% if caller or params.heading or params.text or params.html %}
  {{ innerHtml | safe | trim }}
{% endif %}
{% if image.src %}
  <div class="nhsuk-hero__overlay"></div>
{% endif %}
</section>
