{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/icon.njk" import nhsukIcon %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}

{#- Set variant for this component #}
{%- set variant = params.variant %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-button" %}

{%- if variant and
  variant in ["brand", "login", "reverse", "secondary", "secondary-solid", "warning"] and (
    not params.classes or (
      not "nhsuk-button--brand" in params.classes and
      not "nhsuk-button--login" in params.classes and
      not "nhsuk-button--reverse" in params.classes and
      not "nhsuk-button--secondary" in params.classes and
      not "nhsuk-button--secondary-solid" in params.classes and
      not "nhsuk-button--warning" in params.classes
    )
  )
%}
  {%- set classNames = classNames ~ " nhsuk-button--" ~ variant %}
{%- endif %}

{%- if params.icon and (not params.classes or not "nhsuk-button--icon" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-button--icon" %}
{%- endif %}

{%- if params.small and (not params.classes or not "nhsuk-button--small" in params.classes) %}
  {%- set classNames = classNames ~ " nhsuk-button--small" %}
{%- endif %}

{%- if params.classes %}
  {%- set classNames = classNames ~ " " ~ params.classes %}
{%- endif %}

{#- Determine type of element to use, if not explicitly set #}
{%- if params.element %}
  {%- set element = params.element | lower %}
{%- else %}
  {%- if params.href and not params.type %}
    {%- set element = "a" %}
  {%- else %}
    {%- set element = "button" %}
  {%- endif %}
{%- endif %}

{%- set icon = params.icon -%}

{%- if icon and icon is string %}
  {%- set icon = {
    name: icon,
    placement: "start"
  } %}
{%- endif %}

{#- Define attributes that we can use across all element types #}
{%- set attributesHtml %}
  {{- nhsukAttributes({
    class: classNames,
    id: {
      value: params.id,
      optional: true
    },
    name: {
      value: params.name if element == "button" or element == "input" else false,
      optional: true
    },
    "data-module": "nhsuk-button",
    "data-prevent-double-click": {
      value: params.preventDoubleClick | string | lower
        if params.preventDoubleClick is sameas(true) or
          params.preventDoubleClick is sameas(false)
        else false,
      optional: true
    }
  }) -}}

  {% if element == "button" or element == "input" %}
    {{- nhsukAttributes({
      type: params.type | default("submit"),
      value: {
        value: params.text if element == "input" else params.value,
        optional: true
      },
      disabled: {
        value: params.disabled,
        optional: true
      },
      "aria-label": {
        value: params.ariaLabel,
        optional: true
      },
      "aria-disabled": {
        value: "true" if params.disabled else false,
        optional: true
      }
    }) -}}
  {% elif element == "a" %}
    {{- nhsukAttributes({
      href: params.href | default("#"),
      role: "button",
      draggable: "false",
      "aria-label": {
        value: params.ariaLabel,
        optional: true
      }
    }) -}}
  {% endif %}

  {{- nhsukAttributes(params.attributes) -}}
{% endset %}

{%- set iconHtml = icon.html if icon.html else (nhsukIcon(icon.name) | trim if icon.name) %}

{%- set content = {
  text: params.text,
  html: caller() if caller else params.html,
  visuallyHidden: {
    text: params.visuallyHiddenText,
    placement: "start",
    slots: { end: ": " }
  }
} %}

{%- set slots = {
  before: iconHtml if icon.placement == "start",
  after: iconHtml if icon.placement == "end"
} %}

{%- set innerHtml %}
{%- if (content.text or content.html) and iconHtml -%}
  <span class="nhsuk-button__content">
    {{- nhsukContent(content) | trim -}}
  </span>
{%- else %}
  {{- nhsukContent(content) | trim -}}
{% endif %}
{%- endset %}

{%- if element == "a" %}
<a {{- attributesHtml | safe }}>
  {{ nhsukContent({
    html: innerHtml,
    slots: slots
  }) | trim | indent(2) }}
</a>
{% elif element == "button" %}
<button {{- attributesHtml | safe }}>
  {{ nhsukContent({
    html: innerHtml,
    slots: slots
  }) | trim | indent(2) }}
</button>
{% elif element == "input" %}
<input {{- attributesHtml | safe }}>
{% endif %}
