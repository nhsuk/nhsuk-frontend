{% from "nhsuk/components/visually-hidden/macro.njk" import visuallyHidden as nhsukVisuallyHidden %}
{% from "nhsuk/macros/slot.njk" import nhsukSlot %}

{#-
  Renders text, HTML or visually hidden content
#}
{%- macro nhsukContent(params = {}) %}

{#- Support params as defined value #}
{%- set params = params if params is mapping and params is not escaped else {
  text: params if params is defined and params is not escaped else undefined,
  html: params if params is escaped else undefined
} %}

{#- Support visually hidden content as defined value #}
{%- set visuallyHidden = params.visuallyHidden if params.visuallyHidden is mapping and params.visuallyHidden is not escaped else {
  text: params.visuallyHidden if params.visuallyHidden is defined and params.visuallyHidden is not escaped else params.visuallyHiddenText,
  html: params.visuallyHidden if params.visuallyHidden is escaped else undefined
} %}

{%- set slotBefore = nhsukSlot("before", params) %}
{%- set slotStart = nhsukSlot("start", params) %}
{%- set slotEnd = nhsukSlot("end", params) %}
{%- set slotAfter = nhsukSlot("after", params) %}

{%- set contentHtml = caller() if caller else params.html %}
{%- set contentText %}
  {%- if params.text is escaped %}
    {{- params.text | safe -}}
  {% elif params.text is sameas(true) or params.text is sameas(false) %}
    {{- params.text | string | lower -}}
  {% elif params.text is string or params.text is number %}
    {{- params.text | string -}}
  {% elif params.text is defined and
    params.text is not none and
    params.text is not mapping and
    params.text is iterable %}
    {{- nhsukContentItems(params.text) -}}
  {% endif %}
{%- endset %}

{%- set hasContent = true if contentHtml or contentText | length else false %}
{%- set hasContentSlots = true if slotStart | length or slotEnd | length else false %}

{%- set visuallyHiddenInnerHtml = visuallyHidden.html %}
{%- set visuallyHiddenInnerText = nhsukContent({ text: visuallyHidden.text }) if
  visuallyHidden.text is defined and
  visuallyHidden.text is not none and
  visuallyHidden.text is not sameas(true) and
  visuallyHidden.text is not sameas(false)
  else undefined %}

{%- set hasVisuallyHidden = true if visuallyHiddenInnerHtml or visuallyHiddenInnerText | length else false %}

{#- Set visually hidden slots based on placement #}
{%- set visuallyHiddenSlots = visuallyHidden.slots if visuallyHidden.slots is mapping and visuallyHidden.slots is not escaped else {
  start: " " if hasContent and (visuallyHidden.placement == "end" or not visuallyHidden.placement) else undefined,
  end: " " if hasContent and visuallyHidden.placement == "start" else undefined
} %}

{{- slotBefore -}}

{% if hasContent or hasVisuallyHidden %}
{%- set visuallyHiddenHtml %}
  {{- nhsukVisuallyHidden({
    id: visuallyHidden.id,
    text: visuallyHiddenInnerText,
    html: visuallyHiddenInnerHtml,
    classes: visuallyHidden.classes,
    attributes: visuallyHidden.attributes,
    placement: visuallyHidden.placement,
    element: visuallyHidden.element,
    slots: visuallyHiddenSlots
  }) | trim -}}
{% endset %}

{%- set innerHtml %}
  {{- slotStart -}}

  {% if visuallyHidden.placement == "start" %}
    {{- visuallyHiddenHtml | safe | trim -}}
  {% endif %}

  {%- if contentHtml %}
    {{- contentHtml | safe -}}
  {% else %}
    {{- contentText | safe -}}
  {% endif %}

  {%- if visuallyHidden.placement == "end" or (hasVisuallyHidden and not visuallyHidden.placement) %}
    {{- visuallyHiddenHtml | safe | trim -}}
  {% endif %}

  {{- slotEnd -}}
{% endset %}

{%- if visuallyHidden.placement == "before" %}
  {{- visuallyHiddenHtml | safe | trim -}}

  {{- "\n" | safe if hasContent or hasContentSlots -}}
{% endif %}

{{- innerHtml | safe -}}

{% if visuallyHidden.placement == "after" %}
  {{- "\n" | safe if hasContent or hasContentSlots -}}

  {{- visuallyHiddenHtml | safe | trim -}}
{% endif %}
{%- endif %}

{{- slotAfter -}}

{% endmacro %}

{#-
  Renders array of text, HTML or visually hidden content
#}
{%- macro nhsukContentItems(items, index = 0) %}
  {%- set itemHtml = nhsukContent(items[index]) | trim %}
  {%- set nextHtml = nhsukContentItems(items, index + 1) | trim if index + 1 < items | length else "" %}

  {{- itemHtml -}}
  {{- ", " if itemHtml | length and nextHtml | length -}}
  {{- nextHtml -}}
{% endmacro %}
